# Copy to .env for local development. Never commit real keys.

# Option A: Gemini Developer API key (Google AI Studio)
GEMINI_API_KEY=your-key-here

# Option B: Vertex AI with the Cloud Run service account (no API key needed)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Evidence backend: auto (Google Search grounding, fallback to Wikipedia) | google | wikipedia
SEARCH_BACKEND=auto

# Wikipedia fallback: identify the client per Wikimedia API policy (e.g. your repo URL)
# WIKIPEDIA_CONTACT=https://github.com/your-name/your-repo

# Optional: persist shareable reports in Cloud Firestore
FIRESTORE_ENABLED=false

# Tuning
MAX_SUB_QUESTIONS=4
MAX_CLAIMS_PER_QUESTION=3
RATE_LIMIT_PER_MINUTE=5
